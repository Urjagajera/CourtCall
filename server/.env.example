PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/courtcall

# Any long random string
JWT_SECRET=change-me

# Nexconn Console -> your app -> Key Management (https://console.nexconn.ai)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Server API base URL for your app's region (shown in the Console / docs "Base URL")
NEXCONN_API_BASE=

# Web Push keys: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

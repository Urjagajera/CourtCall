PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase -> Project -> Connect -> "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Nexconn Console -> your app -> Key Management (https://console.nexconn.ai)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Server API base URL for your app's data center, e.g. https://api.sg-light-api.com (Singapore)
NEXCONN_API_BASE=https://api.sg-light-api.com

# Web Push keys. Generate with (from the server folder): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# One-tap demo logins on the sign-in page (needs `npm run seed:demo`). Set to false to hide them.
DEMO_LOGIN=true
